{
  "policy_id": "mastery-default-v1",
  "version": "1.0.0",
  "score_scale": {"min": 0, "max": 4},
  "decision": "ADVANCE only if all gates pass; otherwise REMAIN_AND_REMEDIATE",
  "gates": {
    "minimum_overall_score": 3.0,
    "minimum_each_dimension_score": 2.5,
    "minimum_critical_criterion_score": 2.0,
    "require_evidence_for_each_dimension": true,
    "require_exit_challenge": true,
    "require_comprehension_check": true
  },
  "retry_policy": {
    "allow_practice_between_attempts": true,
    "generate_equivalent_but_not_identical_challenge": true,
    "preserve_prior_evidence_as_history": true,
    "latest_valid_attempt_controls_current_decision": true
  },
  "missing_evidence": "NOT_EVALUATED; never treated as pass or fail; no advancement",
  "assistance_policy": {
    "asking_questions_is_not_automatically_penalized": true,
    "record_assistance_level_and_events": true,
    "assessment_must_require_explanation_or_modification": true
  },
  "overrides": "Instructor may configure policy per course/catalog; every override is versioned and reported."
}
