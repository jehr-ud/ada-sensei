{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "policy_id": "ada-sensei-android-toolchain",
  "policy_version": "1.0.0",
  "resolution_policy": "pinned-compatible-only",
  "repositories": [
    "gradlePluginPortal",
    "google",
    "mavenCentral"
  ],
  "compatibility_matrix": [
    {
      "jdk": "17",
      "gradle": "8.4",
      "kotlin": "1.9.22",
      "agp": "8.1.4",
      "tools": {
        "android_lint": "8.1.4",
        "detekt": "1.23.6",
        "ktlint": "1.1.1"
      }
    },
    {
      "jdk": "17",
      "gradle": "9.5.0",
      "kotlin": "2.2.10",
      "agp": "9.3.3",
      "tools": {
        "android_lint": "9.3.3",
        "detekt": "2.0.0-alpha.5",
        "ktlint": "1.6.0"
      },
      "plugins": {
        "detekt": {
          "id": "dev.detekt",
          "marker": "dev.detekt:dev.detekt.gradle.plugin",
          "version": "2.0.0-alpha.5"
        },
        "ktlint": {
          "id": "org.jlleitschuh.gradle.ktlint",
          "marker": "org.jlleitschuh.gradle.ktlint:org.jlleitschuh.gradle.ktlint.gradle.plugin",
          "version": "14.2.0",
          "core_version": "1.6.0"
        }
      }
    }
  ],
  "tools": {
    "android_lint": {
      "provider": "android_gradle_plugin",
      "required": true,
      "task_resolution": [
        "lint<Variant>",
        "lint"
      ]
    },
    "detekt": {
      "provider": "gradle_plugin",
      "required": true,
      "version_source": "compatibility_matrix"
    },
    "ktlint": {
      "provider": "gradle_plugin_or_cli",
      "required": true,
      "version_source": "compatibility_matrix"
    }
  },
  "execution": {
    "workspace": "isolated_temporary_copy",
    "allow_global_install": false,
    "allow_source_mutation": false,
    "allow_auto_correct": false,
    "require_health_check": true,
    "require_structured_report": true
  },
  "network": {
    "allow_unlisted_repositories": false,
    "allow_unverified_install_scripts": false
  },
  "note": "Only pinned, automatically verified combinations; never latest or floating versions.",
  "verification": [
    "Initial entry: tests/toolchain/test_manager.py with a deterministic runner.",
    "Domino entry: real Gradle 9.5.0 run in an isolated copy; lint, detekt and ktlint produced validated reports.",
    "Pending: artifact checksums for downloaded Gradle plugin markers."
  ]
}
