{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ada-sensei.local/schemas/exam-definition.schema.json",
  "title": "ADA Sensei Exam Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exam_id",
    "title",
    "version",
    "requirements",
    "rubric_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "exam_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "statement_language": {
      "enum": [
        "es-CO",
        "en-US"
      ]
    },
    "allowed_duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "allowed_ask_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "project_constraints": {
      "type": "object"
    },
    "documentation_rules": {
      "type": "object",
      "properties": {
        "accepted_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "rubric_ref": {
      "type": "string",
      "const": "unified-android:v1"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "description",
          "weight",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]+$"
          },
          "type": {
            "enum": [
              "functional",
              "technical",
              "documentation",
              "testing"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "section"
            ],
            "additionalProperties": false
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "description",
                "verification"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "verification": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "unit_test",
                      "build",
                      "static_analysis",
                      "source_inspection",
                      "ui_inspection",
                      "manual_review",
                      "documentation_check"
                    ]
                  }
                },
                "evidence_hints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "related_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
