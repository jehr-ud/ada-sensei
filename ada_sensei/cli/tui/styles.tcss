Screen {
    layout: vertical;
}

#session-bar {
    dock: top;
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

#log {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#status-indicator {
    display: none;
    height: 1;
    min-height: 1;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

#action-row {
    height: 3;
    padding: 0 1;
}

#action-select {
    width: 1fr;
}

#input {
    width: 1fr;
    height: 7;
    max-height: 40%;
    border: tall $primary;
}

#prompt-label {
    width: auto;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}

#session-footer {
    height: 1;
    background: $boost;
    color: $text;
    padding: 0 1;
}
